---
---

<section id="products" class="py-24 px-6 relative">
  <!-- Top accent line -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[1px] bg-gradient-to-r from-transparent via-[rgba(231,159,116,0.2)] to-transparent"></div>

  <div class="max-w-4xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16 reveal-up">
      <div class="section-badge">
        <span class="section-badge-dot"></span>
        Our Products
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">What we're building</h2>
    </div>

    <!-- Molt Code product card -->
    <div class="product-card card-hover rounded-2xl p-8 sm:p-10 bg-surface-solid relative overflow-hidden reveal-up" style="animation-delay: 0.15s;">
      <!-- Gradient top border -->
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[rgba(231,159,116,0.5)] to-transparent"></div>

      <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">
        <!-- Left: Product info -->
        <div class="flex-1">
          <div class="flex items-center gap-4 mb-5">
            <!-- Molt Code icon -->
            <svg width="44" height="44" viewBox="0 0 64 64" class="rounded-xl shadow-lg flex-shrink-0">
              <defs>
                <linearGradient id="mcBgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#27272a"/>
                  <stop offset="100%" stop-color="#3f3f46"/>
                </linearGradient>
                <linearGradient id="mcCopperGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#b45309"/>
                  <stop offset="50%" stop-color="#d97706"/>
                  <stop offset="100%" stop-color="#92400e"/>
                </linearGradient>
                <linearGradient id="mcBronzeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#f59e0b"/>
                  <stop offset="100%" stop-color="#d97706"/>
                </linearGradient>
              </defs>
              <rect x="0" y="0" width="64" height="64" rx="14" fill="url(#mcBgGrad)"/>
              <rect x="12" y="30" width="16" height="24" rx="4" fill="url(#mcCopperGrad)"/>
              <rect x="34" y="20" width="16" height="34" rx="4" fill="url(#mcCopperGrad)" opacity="0.7"/>
              <rect x="24" y="10" width="16" height="28" rx="4" fill="url(#mcBronzeGrad)"/>
            </svg>
            <div>
              <h3 class="text-2xl font-bold">Molt Code</h3>
              <p class="text-theme-accent text-sm font-medium">Orchestrate AI Coding Agents</p>
            </div>
          </div>

          <p class="text-theme-secondary leading-relaxed mb-6">
            A free desktop app that gives you a cohesive place for all the collaboration
            of AI workloads. Write a spec, generate dependency-tracked issues, and let a
            tree of agents implement &mdash; using Claude, Codex, or Gemini with your own API keys.
          </p>

          <!-- Feature chips -->
          <div class="flex flex-wrap gap-2 mb-8 lg:mb-0">
            <span class="chip">
              <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Free forever
            </span>
            <span class="chip">
              <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Bring your own keys
            </span>
            <span class="chip">
              <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              macOS
            </span>
            <span class="chip">
              <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Open source
            </span>
          </div>
        </div>

        <!-- Right: CTAs -->
        <div class="flex flex-col gap-3 lg:pt-8 w-full lg:w-auto">
          <a
            href="https://moltcode.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary px-6 py-3 rounded-xl text-sm whitespace-nowrap"
          >
            Visit moltcode.com
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          </a>
          <a
            href="https://github.com/moltcode/moltcode"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary px-6 py-3 rounded-xl text-sm whitespace-nowrap"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-secondary);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: rgba(var(--color-accent-rgb), 0.06);
    border: 1px solid rgba(var(--color-accent-rgb), 0.1);
  }
</style>
