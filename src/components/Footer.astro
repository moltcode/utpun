---
---

<footer class="py-12 px-6 border-t border-theme-border">
  <div class="max-w-4xl mx-auto">
    <div class="grid md:grid-cols-3 gap-10 mb-10">
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5 mb-3">
          <svg width="24" height="24" viewBox="0 0 64 64" class="rounded-md">
            <defs>
              <linearGradient id="footerBgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#27272a"/>
                <stop offset="100%" stop-color="#3f3f46"/>
              </linearGradient>
              <linearGradient id="footerCopperGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#b45309"/>
                <stop offset="50%" stop-color="#d97706"/>
                <stop offset="100%" stop-color="#92400e"/>
              </linearGradient>
            </defs>
            <rect x="0" y="0" width="64" height="64" rx="14" fill="url(#footerBgGrad)"/>
            <path d="M 18 16 L 18 38 C 18 46 24 52 32 52 C 40 52 46 46 46 38 L 46 16"
              fill="none"
              stroke="url(#footerCopperGrad)"
              stroke-width="7"
              stroke-linecap="round"
              stroke-linejoin="round"/>
          </svg>
          <span class="text-lg font-bold text-theme-primary">Utpun</span>
        </div>
        <p class="text-sm text-theme-secondary mb-1">Utpun Tech Labs Private Limited</p>
        <p class="text-sm text-theme-secondary/70">Building tools for AI-native developer workflows.</p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-sm font-semibold text-theme-primary mb-4">Links</h4>
        <ul class="space-y-2.5">
          <li>
            <a
              href="https://moltcode.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-theme-secondary hover:text-theme-accent transition-colors"
            >Molt Code</a>
          </li>
          <li>
            <a
              href="https://github.com/moltcode/moltcode"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-theme-secondary hover:text-theme-accent transition-colors"
            >GitHub</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 border-t border-theme-border">
      <p class="text-xs text-theme-secondary/50">&copy; 2026 Utpun Tech Labs Private Limited. All rights reserved.</p>
    </div>
  </div>
</footer>
