---
---

<section class="relative pt-36 pb-24 px-6 overflow-hidden">
  <!-- Subtle floating orb -->
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[400px] rounded-full animate-float opacity-30 pointer-events-none"
    style="background: radial-gradient(ellipse, rgba(231, 159, 116, 0.12) 0%, transparent 70%); filter: blur(60px);"
  ></div>

  <div class="max-w-3xl mx-auto relative z-10 text-center">
    <!-- Company badge -->
    <div class="section-badge hero-fade" style="animation-delay: 0.1s;">
      <span class="section-badge-dot"></span>
      Utpun Tech Labs
    </div>

    <!-- Heading -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight leading-[1.1] mb-8">
      <span class="hero-line block" style="animation-delay: 0.3s;">Building tools for the</span>
      <span class="hero-line block gradient-text" style="animation-delay: 0.5s;">AI-native developer.</span>
    </h1>

    <!-- Subheading -->
    <p class="text-lg sm:text-xl text-theme-secondary max-w-2xl mx-auto mb-10 hero-fade leading-relaxed" style="animation-delay: 0.8s;">
      We create open, purpose-built software that puts developers in control
      of their AI workflows. No lock-in. No middlemen. Just thoughtfully designed tools.
    </p>

    <!-- CTA -->
    <div class="hero-fade" style="animation-delay: 1.1s;">
      <a
        href="#products"
        class="btn-secondary px-6 py-3 rounded-full text-sm"
      >
        Explore our products
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
        </svg>
      </a>
    </div>
  </div>
</section>
